{
  "name": "hryvinskyi/magento2-csp",
  "version": "2.0.0",
  "description": "Content Security Policy management for Magento 2: admin whitelist per store and area, violation reports with conversion, semantics-preserving header optimisation and splitting, script hashes for CMS content",
  "type": "magento2-module",
  "require": {
    "ext-dom": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "php": ">=8.1 <8.5",
    "hryvinskyi/magento2-base": "^2.1.6",
    "hryvinskyi/magento2-logger": "^1.1",
    "laminas/laminas-http": "^2.15",
    "laminas/laminas-loader": "^2.8",
    "magento/framework": "^103.0.6",
    "magento/module-backend": "^102.0.6",
    "magento/module-cms": "^104.0.6",
    "magento/module-config": "^101.2.6",
    "magento/module-csp": "^100.4.5",
    "magento/module-email": "^101.1.6",
    "magento/module-store": "^101.1.6",
    "magento/module-ui": "^101.2.6",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "symfony/console": "^5.4 || ^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0 || ^10.0"
  },
  "authors": [
    {
      "name": "Volodymyr Hryvinskyi",
      "email": "volodymyr@hryvinskyi.com"
    }
  ],
  "license": "MIT",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Hryvinskyi\\Csp\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hryvinskyi\\Csp\\Test\\": "Test/"
    }
  }
}
