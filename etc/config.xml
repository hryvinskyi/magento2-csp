<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <csp>
            <general>
                <enabled_rules>1</enabled_rules>
                <enabled_reports>1</enabled_reports>
                <enable_header_splitting>0</enable_header_splitting>
                <max_header_size>4096</max_header_size>
                <enable_value_optimization>0</enable_value_optimization>
                <enable_redundant_wildcard_removal>0</enable_redundant_wildcard_removal>
                <enable_default_src_consolidation>0</enable_default_src_consolidation>
                <enable_subdomain_wildcard_consolidation>0</enable_subdomain_wildcard_consolidation>
                <subdomain_wildcard_threshold>3</subdomain_wildcard_threshold>
                <subdomain_wildcard_parents/>
                <enable_scheme_path_stripping>0</enable_scheme_path_stripping>
            </general>
            <report_ingestion>
                <rate_limit>120</rate_limit>
                <max_body_bytes>65536</max_body_bytes>
            </report_ingestion>
            <report_cleanup>
                <enabled>1</enabled>
                <mode>date</mode>
                <threshold>30</threshold>
            </report_cleanup>
        </csp>
    </default>
</config>
